---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import { pick, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = (await getCollection('uses')).sort((a, b) => a.data.order - b.data.order);
---

<Layout lang={lang} title={t('uses.title')} description={t('uses.intro')} ownAvatar>
  <section class="wrap page">
    <div class="intro">
      <div class="section-head">
        <p class="eyebrow">{t('uses.updated')}</p>
        <h1>{t('uses.title')}</h1>
        <p>{t('uses.intro')}</p>
      </div>
      <PixelAvatar lang={lang} size="clamp(150px, 20vw, 220px)" airpods follow expr="smile" bubbleSide="top" vt />
    </div>

    {
      groups.map(({ data: g }) => (
        <section class="group">
          <h2>{pick(g.title, lang)}</h2>
          <ul>
            {g.items.map((item) => (
              <li data-mood="smile" data-say={pick(item.note, lang)}>
                {item.url ? (
                  <a href={item.url} target="_blank" rel="noreferrer">
                    {item.name}
                  </a>
                ) : (
                  <span class="name">{item.name}</span>
                )}
                <span class="note">{pick(item.note, lang)}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Layout>

<style>
  .page {
    padding-block: clamp(48px, 8vw, 96px);
  }
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 72px 32px;
    margin-bottom: 40px;
  }
  h1 {
    font-size: clamp(46px, 7vw, 88px);
    letter-spacing: -0.035em;
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
    gap: 16px 40px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .group h2 {
    font-size: 24px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    gap: 4px 24px;
    align-items: baseline;
  }
  li a,
  .name {
    font: 700 20px/1.3 var(--display);
    text-decoration: none;
  }
  li a:hover {
    color: var(--brand-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .note {
    color: var(--ink-2);
  }
  @media (max-width: 720px) {
    .group,
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
