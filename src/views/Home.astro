      scale: 1 1;
    }
    100% {
      translate: var(--dx) var(--dy);
      opacity: 0;
      scale: 0.6 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .puff,
    .rays,
    .star.tw,
    .h1,
    .h2 {
      animation: none;
    }
    .p1 {
      translate: 30vw 0;
    }
    .p2 {
      translate: 60vw 0;
    }
    .p3 {
      translate: 78vw 0;
    }
  }
