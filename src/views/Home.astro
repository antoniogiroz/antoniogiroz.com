---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PixelAvatar from '../components/PixelAvatar.astro';
import { BLUESKY, socials, techIcons, type Ring } from '../constants';
import { localePath, pick, useTranslations, type Lang } from '../i18n/ui';
import { formatDate, getPosts, postSlug } from '../lib/posts';
import { appIcons, bat, bird, ufo } from '../lib/pixels';
import { features } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The word in [brackets] gets the pixel underline
const titleParts = t('hero.title').match(/^(.*)\[(.+)\](.*)$/);
const [titleStart, titleMark, titleEnd] = titleParts ? titleParts.slice(1) : [t('hero.title'), '', ''];

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getPosts(lang)).slice(0, 3);
const statusLabel = {
  live: t('apps.status.live'),
  building: t('apps.status.building'),
  idea: t('apps.status.idea'),
} as const;
const countLabel = { live: t('apps.count.live'), building: t('apps.count.building'), idea: t('apps.count.idea') } as const;
const counts = (['live', 'building', 'idea'] as const)
  .map((status) => ({ status, n: projects.filter((p) => p.data.status === status).length }))
  .filter((c) => c.n);

// Sections are numbered in order; Notes only exists when there is a note
const sections = [...(features.apps ? ['apps'] : []), 'stack', ...(posts.length ? ['blog'] : []), 'contact'];
const num = (id: string) => String(sections.indexOf(id) + 1).padStart(2, '0');

/* Orbits: the closer to the avatar, the more I use it. Sizes are % of the orbit width (cqw) */
const rings: { id: Ring; label: string; r: number; dur: number; reverse: boolean; offset: number }[] = [
  { id: 'core', label: t('stack.ring.core'), r: 23, dur: 240, reverse: false, offset: -90 },
  { id: 'tools', label: t('stack.ring.tools'), r: 34.5, dur: 320, reverse: true, offset: -54 },
  { id: 'ship', label: t('stack.ring.ship'), r: 45.5, dur: 400, reverse: false, offset: -45 },
];
const orbits = rings.map((ring) => ({ ...ring, items: techIcons.filter((tech) => tech.ring === ring.id) }));
const ringLabel = Object.fromEntries(rings.map((r) => [r.id, r.label]));
const tools = Object.fromEntries(techIcons.map((tech) => [tech.id, { name: tech.title, ring: ringLabel[tech.ring], say: tech.say[lang] }]));
const first = techIcons[0];

/* A cloud is a few soft puffs of vapour: [x %, y %, size %] of the cloud box, flat at the bottom */
const blobs: [number, number, number][] = [
  [4, 46, 30], [16, 30, 40], [33, 12, 46], [52, 18, 44], [68, 32, 36], [80, 48, 26],
  [24, 50, 34], [46, 48, 38], [64, 52, 30], [10, 60, 24], [86, 60, 18],
];

/* Night sky: irregular stars from a seeded random generator, so every build is the same */
function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = seeded(1948);
const tints = ['#ffffff', '#ffffff', '#ffffff', '#e2f1ff', '#cfe4ff', '#fff1d6'];
const makeStar = (x: number, y: number) => {
  const size = 0.8 + rand() ** 3 * 2.4;
  return {
    x,
    y,
    size,
    color: tints[Math.floor(rand() * tints.length)],
    opacity: 0.35 + rand() * 0.65,
    twinkle: rand() < 0.4,
    duration: 2 + rand() * 5,
    delay: -rand() * 7,
  };
};
const gauss = () => (rand() + rand() + rand() - 1.5) / 1.5;
const stars = [
  // Scattered, more of them near the top
  ...Array.from({ length: 90 }, () => makeStar(rand() * 100, rand() ** 1.4 * 92)),
  // A denser band along the Milky Way
  ...Array.from({ length: 45 }, () => {
    const t = rand();
    return makeStar(t * 100, 70 - t * 62 + gauss() * 9);
  }),
].filter((s) => s.y > 0 && s.y < 100);
// The brightest few get a cross-shaped sparkle
stars
  .map((s, i) => [s.size, i] as const)
  .sort((a, b) => b[0] - a[0])
  .slice(0, 6)
  .forEach(([, i]) => Object.assign(stars[i], { sparkle: true, opacity: 1 }));

const hills = [
  'M0 190C180 128 350 150 520 170S860 116 1040 148S1320 128 1440 158V320H0Z',
  'M0 232C210 188 390 214 570 226S910 186 1110 214S1340 198 1440 214V320H0Z',
  'M0 272C240 246 430 262 650 268S1050 244 1250 262S1400 254 1440 258V320H0Z',
];
---

<Layout lang={lang} home>
  <section
    class="hero"
    data-say-bird={t('sky.bird')}
    data-say-bird-click={t('sky.birdClick')}
    data-say-wish={t('sky.wish')}
    data-say-bat={t('sky.bat')}
    data-say-bat-click={t('sky.batClick')}
    data-say-ufo={t('sky.ufo')}
    data-say-ufo-click={t('sky.ufoClick')}
  >
    <div class="sky" aria-hidden="true">
      <div class="day">
        <span class="daylight"></span>
        <div class="sun">
          <span class="glow"></span>
          <span class="rays"></span>
          <span class="disc"></span>
        </div>
        <span class="puff p1">{blobs.map((b) => <i style={`--bx:${b[0]}%;--by:${b[1]}%;--bs:${b[2]}%`} />)}</span>
        <span class="puff p2">{blobs.map((b) => <i style={`--bx:${b[0]}%;--by:${b[1]}%;--bs:${b[2]}%`} />)}</span>
        <span class="puff p3">{blobs.map((b) => <i style={`--bx:${b[0]}%;--by:${b[1]}%;--bs:${b[2]}%`} />)}</span>
      </div>
      <div class="night">
        <span class="galaxy"></span>
        {
          stars.map((s) => (
            <i
              class:list={['star', { tw: s.twinkle, sparkle: 'sparkle' in s }]}
              style={`--x:${s.x.toFixed(2)}%;--y:${s.y.toFixed(2)}%;--s:${s.size.toFixed(2)}px;--c:${s.color};--o:${s.opacity.toFixed(2)};--d:${s.duration.toFixed(2)}s;--dl:${s.delay.toFixed(2)}s`}
            />
          ))
        }
        <span class="moon"><span class="crater k1"></span><span class="crater k2"></span><span class="crater k3"></span></span>
      </div>
      <svg class="hills" viewBox="0 0 1440 320" preserveAspectRatio="none">
        {hills.map((d, i) => <path class={`h${i + 1}`} d={d} />)}
      </svg>
      <div class="actors"></div>
    </div>
    <template id="tpl-bird">
      <span class="bird" role="button" tabindex="-1">
        <span class="bob">
          <svg class="wing up" viewBox="0 0 9 4" shape-rendering="crispEdges">{bird.up.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}</svg>
          <svg class="wing down" viewBox="0 0 9 4" shape-rendering="crispEdges">{bird.down.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}</svg>
        </span>
      </span>
    </template>
    <template id="tpl-bat">
      <span class="bird bat" role="button" tabindex="-1">
        <span class="bob flutter">
          <svg class="wing up" viewBox="0 0 13 6" shape-rendering="crispEdges">{bat.up.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}</svg>
          <svg class="wing down" viewBox="0 0 13 6" shape-rendering="crispEdges">{bat.down.map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}</svg>
        </span>
      </span>
    </template>
    <template id="tpl-shoot"><span class="shoot"></span></template>
    <template id="tpl-ufo">
      <span class="ufo" role="button" tabindex="-1">
        <span class="bob">
          <svg viewBox="0 0 13 8" shape-rendering="crispEdges">
            {ufo.map(([x, y, c]) => <rect x={x} y={y} width="1" height="1" class={c} />)}
          </svg>
          <span class="beam"></span>
        </span>
      </span>
    </template>
    <div class="wrap hero-grid">
      <div class="hero-slot" data-avatar-from>
        <div class="flyer" data-flyer>
          <PixelAvatar lang={lang} size="100%" follow sleepy greet bubbleSide="top" vt />
        </div>
      </div>
      <div class="hero-text">
        <p class="meta">{t('hero.meta')}</p>
        <h1>
          {titleStart}<span class="mark">{titleMark}</span>{titleEnd}
        </h1>
        <p class="body">{t('hero.body')}</p>
        <div class="ctas">
          {
            features.apps ? (
              <a class="btn primary" href="#apps" data-mood="grin">
                {t('hero.cta.apps')}
              </a>
            ) : (
              <a class="btn primary" href="#stack" data-mood="grin">
                {t('hero.cta.stack')}
              </a>
            )
          }
          <a class="btn" href="#contact" data-mood="smile">{t('hero.cta.contact')}</a>
        </div>
        <p class="clock" data-clock data-awake={t('clock.awake')} data-asleep={t('clock.asleep')}>
          <span class="dot" aria-hidden="true"></span>
          <span>{t('clock.city')} · <time data-time>--:--</time> · <span data-state>{t('clock.awake')}</span></span>
        </p>
      </div>
    </div>
  </section>

  {features.apps && (
  <section class="section" id="apps" data-narrate={t('narrator.apps')}>
    <div class="wrap">
      <div class="section-top">
        <div class="section-head">
          <p class="eyebrow">{num('apps')} · {t('nav.apps')}</p>
          <h2>{t('apps.title')}</h2>
          <p>{t('apps.intro')}</p>
        </div>
        <p class="counter">
          {
            counts.map((c, i) => (
              <span>
                {i > 0 && <span aria-hidden="true"> · </span>}
                <b>{c.n}</b> {countLabel[c.status]}
              </span>
            ))
          }
        </p>
      </div>
      <ul class="apps">
        {
          projects.map(({ data: p }) => (
            <li class="app" data-mood={p.mood} data-say={pick(p.say, lang)}>
              <div class="app-top">
                <span class="app-icon" style={p.icon === 'avatar' ? undefined : `background: ${appIcons[p.icon].bg}`}>
                  {p.icon === 'avatar' ? (
                    <img src="/images/antonio-giroz.png" alt="" width="96" height="96" loading="lazy" />
                  ) : (
                    <svg viewBox="-1.5 -1.5 14 14" shape-rendering="crispEdges" aria-hidden="true">
                      {appIcons[p.icon].cells.map(([x, y, c]) => <rect x={x} y={y} width="1" height="1" fill={c} />)}
                    </svg>
                  )}
                </span>
                <div class="app-title">
                  <h3>{p.name}</h3>
                  <p class="app-tags">
                    <span class:list={['status', p.status]}>{statusLabel[p.status]}</span>
                    <span>{p.platforms.join(' · ')}</span>
                  </p>
                </div>
              </div>
              <p class="app-desc">{pick(p.description, lang)}</p>
              <div class="app-foot">
                <span>{p.stack.join(' · ')}</span>
                {p.repo && (
                  <a href={p.repo} target="_blank" rel="noreferrer">
                    {t('apps.code')} <span aria-hidden="true">↗</span>
                  </a>
                )}
                {p.url && (
                  <a href={p.url}>
                    {t('apps.open')} <span aria-hidden="true">→</span>
                  </a>
                )}
                {p.follow && (
                  <a href={BLUESKY} target="_blank" rel="noreferrer">
                    {t('apps.follow')} <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  )}

  <section class="section stack" id="stack" data-narrate={t('narrator.stack')}>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{num('stack')} · {t('nav.stack')}</p>
        <h2>{t('stack.title')}</h2>
        <p>{t('stack.intro')}</p>
      </div>
      <div class="stack-grid">
        <div class="orbit">
          <div class="glow" aria-hidden="true"></div>
          {orbits.map((ring) => <span class="ring-line" style={`--r: ${ring.r}`} aria-hidden="true" />)}
          {
            orbits.map((ring) => (
              <ul class:list={['orbit-ring', { reverse: ring.reverse }]} style={`--r: ${ring.r}; --dur: ${ring.dur}s`} aria-label={ring.label}>
                {ring.items.map((tech, i) => (
                  <li style={`--a: ${ring.offset + (360 / ring.items.length) * i}deg`}>
                    <button type="button" class="planet" data-tool={tech.id} data-mood={tech.mood} aria-label={tech.title} aria-pressed={tech.id === first.id ? 'true' : 'false'}>
                      <Icon name={tech.mono} class="mono" aria-hidden="true" />
                      <Icon name={tech.icon} class="color" aria-hidden="true" />
                    </button>
                  </li>
                ))}
              </ul>
            ))
          }
          <div class="core">
            <PixelAvatar lang={lang} size="100%" follow bubble={false} />
          </div>
        </div>

        <div class="stack-side">
          <div class="chips">
            {
              orbits.map((ring) => (
                <div class="chip-group">
                  <p class="eyebrow">{ring.label}</p>
                  <ul>
                    {ring.items.map((tech) => (
                      <li>
                        <button type="button" class="chip" data-tool={tech.id} data-mood={tech.mood} aria-pressed={tech.id === first.id ? 'true' : 'false'}>
                          <Icon name={tech.mono} aria-hidden="true" />
                          {tech.title}
                        </button>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
          <aside class="tool-card" data-tool-card data-tools={JSON.stringify(tools)}>
            <div class="tool-head">
              <span class="tool-icon">
                {techIcons.map((tech) => (
                  <span data-icon={tech.id} hidden={tech.id !== first.id}>
                    <Icon name={tech.icon} aria-hidden="true" />
                  </span>
                ))}
              </span>
              <div>
                <p class="tool-name" data-name>{first.title}</p>
                <p class="tool-ring" data-ring>{ringLabel[first.ring]}</p>
              </div>
            </div>
            <div class="tool-say">
              <PixelAvatar lang={lang} size="48px" follow bubble={false} class="card-avatar" />
              <p class="say" data-say aria-live="polite">{first.say[lang]}</p>
            </div>
            <ol class="legend">
              {rings.map((ring, i) => (
                <li>
                  <b>{t('stack.ringN')} {i + 1}</b> · {ring.label}
                </li>
              ))}
            </ol>
          </aside>
        </div>
      </div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section" id="blog" data-narrate={t('narrator.blog')}>
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">
              {num('blog')} · {t('nav.blog')}
            </p>
            <h2>{t('blog.title')}</h2>
            <p>{t('blog.intro')}</p>
          </div>
          <ul class="posts">
            {posts.map((post) => (
              <li>
                <a href={localePath(lang, `/blog/${postSlug(post)}`)} data-mood="smile">
                  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
                  <span class="post-title">{post.data.title}</span>
                  <span class="post-desc">{post.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="more" href={localePath(lang, '/blog')}>
            {t('blog.all')} <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )
  }

  <section class="section contact" id="contact" data-narrate={t('narrator.contact')}>
    <div class="dusk" aria-hidden="true">
      <span class="dusk-sky"></span>
      <span class="dusk-sun"></span>
      <span class="dusk-moon"></span>
      <svg class="dusk-hills" viewBox="0 0 1440 320" preserveAspectRatio="none">
        {hills.map((d, i) => <path class={`d${i + 1}`} d={d} />)}
      </svg>
    </div>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{num('contact')} · {t('nav.contact')}</p>
        <h2>{t('contact.title')}</h2>
        <p>{t('contact.body')}</p>
      </div>
      <ul class="socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="me noreferrer" data-mood="grin" data-say={s.handle}>
                <Icon name={s.icon} aria-hidden="true" />
                <span class="s-name">{s.name}</span>
                <span class="s-handle">{s.handle}</span>
                <span class="s-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="hill-avatar">
      <PixelAvatar lang={lang} size="clamp(56px, 6vw, 76px)" follow bubbleSide="top" />
    </div>
  </section>
</Layout>

<script>
  /*
   * The hero avatar flies to the header when you scroll past it, and flies back
   * when you return. Each flight is a complete, sober animation (a gently
   * curved path), not a position tied to the scroll.
   */
  const from = document.querySelector<HTMLElement>('[data-avatar-from]');
  const to = document.querySelector<HTMLElement>('[data-avatar-to]');
  const flyer = document.querySelector<HTMLElement>('[data-flyer]');
  if (from && to && flyer) setupFlight(from, to, flyer);

  function setupFlight(from: HTMLElement, to: HTMLElement, flyer: HTMLElement) {
    const root = document.documentElement;
    const avatar = flyer.querySelector('pixel-avatar') as (HTMLElement & { setMood?: (expr: string, ms: number) => void }) | null;
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DOCK = 34;
    let size = 0;
    let docked = false;

    // Transform for the avatar's center at (cx, cy), tilted and scaled (origin: center)
    const at = (cx: number, cy: number, scale: number, tilt = 0) =>
      `translate(${cx - size / 2}px, ${cy - size / 2}px) rotate(${tilt}deg) scale(${scale})`;
    const center = (r: DOMRect) => [r.left + r.width / 2, r.top + r.height / 2] as const;
    // The dock grows to 34px while the avatar lands; aim at its final center
    const dockCenter = () => {
      const r = to.getBoundingClientRect();
      return [r.left + DOCK / 2, r.top + r.height / 2] as const;
    };

    // Dock when the middle of the avatar goes under the header; undock a bit lower (no flapping)
    const limits = () => {
      const top = from.getBoundingClientRect().top + scrollY;
      const headerBottom = to.getBoundingClientRect().bottom + 14;
      const dockAt = Math.max(80, top + size * 0.5 - headerBottom);
      return { dockAt, undockAt: dockAt - Math.max(60, size * 0.3) };
    };

    const settleInSlot = () => {
      flyer.classList.remove('is-fixed');
      flyer.style.transform = '';
      flyer.removeAttribute('data-flying');
    };

    /*
     * One continuous flight: the center moves along a curved path (a quadratic
     * Bezier bent slightly to one side), with a single ease-out for position and
     * scale. The curve is sampled into 90 keyframes and played by the compositor,
     * so it stays smooth even when the page is busy.
     * - To the header: fixed position, the dock does not move.
     * - Back to the hero: relative to the hero slot, so it lands exactly there
     *   even if you keep scrolling.
     * A flight always starts where the avatar is now, even in the middle of another one.
     */
    // Ease-out: the avatar leaves at full speed (it was moving with the scroll) and slows to land
    const ease = (x: number) => 1 - (1 - x) ** 3;
    const DURATION = 680;
    const STEPS = 90;
    let flight: Animation | null = null;

    type Place = (x: number, y: number, scale: number, tilt: number) => string;
    function curve(sx: number, sy: number, ex: number, ey: number, s0: number, s1: number, tilt: number, place: Place) {
      const dx = ex - sx;
      const dy = ey - sy;
      const cx = sx + dx / 2 - dy * 0.08;
      const cy = sy + dy / 2 + dx * 0.08;
      return Array.from({ length: STEPS + 1 }, (_, i) => {
        const e = ease(i / STEPS);
        const u = 1 - e;
        const x = u * u * sx + 2 * u * e * cx + e * e * ex;
        const y = u * u * sy + 2 * u * e * cy + e * e * ey;
        return { transform: place(x, y, s0 + (s1 - s0) * e, Math.sin(Math.PI * e) * tilt) };
      });
    }

    // Where the avatar is on screen right now, and how big (also in the middle of a flight)
    // No speech bubble in flight: it hides at once
    const hush = () => flyer.querySelector('.bubble')?.removeAttribute('data-show');

    const current = () => {
      const r = flyer.getBoundingClientRect();
      return { c: center(r), scale: Math.min(1, r.width / size) };
    };

    function dock(animate: boolean) {
      const now = current();
      docked = true;
      flight?.cancel();
      root.setAttribute('data-avatar-docked', '');
      flyer.setAttribute('data-docked', '');
      flyer.classList.remove('returning');
      flyer.classList.add('is-fixed');
      const [ex, ey] = dockCenter();
      const s = DOCK / size;
      flyer.style.transform = at(ex, ey, s);
      // Docked, it talks from the header: the bubble hangs under the capsule at normal size
      flyer.style.setProperty('--dock-scale', String(s));
      avatar?.setAttribute('data-side', 'below');
      if (!animate) return;
      flyer.setAttribute('data-flying', '');
      hush();
      flight = flyer.animate(curve(now.c[0], now.c[1], ex, ey, now.scale, s, 0, at), { duration: DURATION, easing: 'linear' });
      flight.finished.then(() => flyer.removeAttribute('data-flying')).catch(() => {});
    }

    function undock(animate: boolean) {
      const now = current();
      docked = false;
      flight?.cancel();
      root.removeAttribute('data-avatar-docked');
      flyer.removeAttribute('data-docked');
      avatar?.setAttribute('data-side', 'top');
      settleInSlot();
      if (!animate) return;
      const [ex, ey] = center(from.getBoundingClientRect());
      // Relative to the slot: the path moves with the page, so the landing is exact
      const rel: Place = (x, y, scale, tilt) => `translate(${x - ex}px, ${y - ey}px) rotate(${tilt}deg) scale(${scale})`;
      flyer.classList.add('returning');
      flyer.setAttribute('data-flying', '');
      hush();
      flight = flyer.animate(curve(now.c[0], now.c[1], ex, ey, now.scale, 1, 0, rel), { duration: DURATION, easing: 'linear' });
      flight.finished
        .then(() => {
          flyer.classList.remove('returning');
          flyer.removeAttribute('data-flying');
        })
        .catch(() => {});
    }

    const check = () => {
      const { dockAt, undockAt } = limits();
      if (!docked && scrollY > dockAt) dock(!calm);
      else if (docked && scrollY < undockAt) undock(!calm);
    };

    const measure = () => {
      size = from.getBoundingClientRect().width;
      flyer.style.setProperty('--fly', `${size}px`);
      if (docked) {
        const [ex, ey] = dockCenter();
        flyer.style.transform = at(ex, ey, DOCK / size);
        flyer.style.setProperty('--dock-scale', String(DOCK / size));
      }
      check();
    };

    let queued = false;
    addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          check();
        });
      },
      { passive: true },
    );
    addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    measure();
    // Already scrolled on load (a link to #apps, or a reload): dock without a flight
    if (scrollY > limits().dockAt && !docked) dock(false);

    flyer.addEventListener('click', () => {
      if (docked) scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<script>
  /*
   * Life in the sky: birds by day, shooting stars and a rare UFO at night.
   * Everything waits while the hero is off screen or the tab is hidden.
   */
  const hero = document.querySelector<HTMLElement>('.hero');
  const actors = hero?.querySelector<HTMLElement>('.actors');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero && actors && !reduce) {
    let onScreen = true;
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      // CSS pauses every sky animation while nobody can see it
      hero.toggleAttribute('data-idle', !onScreen);
    }).observe(hero);
    const awake = () => onScreen && document.visibilityState === 'visible';
    const dark = () => document.documentElement.dataset.theme === 'dark';
    const between = (a: number, b: number) => a + Math.random() * (b - a);
    const say = (key: string, expr: string, ms = 1800) =>
      document.dispatchEvent(new CustomEvent('avatar:mood', { detail: { expr, say: hero.dataset[key], ms } }));

    const spawn = (id: string, vars: Record<string, string>, attrs: Record<string, string> = {}) => {
      const tpl = document.getElementById(id) as HTMLTemplateElement | null;
      const el = tpl?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
      if (!el) return null;
      for (const [k, v] of Object.entries(vars)) el.style.setProperty(k, v);
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
      el.addEventListener('animationend', (e) => e.target === el && el.remove());
      actors.append(el);
      return el;
    };
    const speedUp = (el: HTMLElement, rate: number) => el.getAnimations().forEach((a) => (a.playbackRate = rate));

    function flock() {
      const size = Math.random() < 0.3 ? 1 : Math.ceil(between(1, 4));
      const dir = Math.random() < 0.5 ? 'right' : 'left';
      const top = between(8, 30);
      const dur = between(14, 22);
      for (let i = 0; i < size; i++) {
        window.setTimeout(() => {
          const bird = spawn(
            'tpl-bird',
            {
              '--top': `${top + between(-6, 6)}%`,
              '--dur': `${dur + between(-1.5, 1.5)}s`,
              '--rise': `${between(-80, 40)}px`,
              '--scale': between(0.75, 1.25).toFixed(2),
            },
            { 'data-dir': dir },
          );
          bird?.addEventListener('click', () => {
            speedUp(bird, 5);
            say('sayBirdClick', 'grin');
          });
        }, i * between(250, 600));
      }
      if (Math.random() < 0.3) window.setTimeout(() => say('sayBird', 'smile'), 2500);
    }

    // Bats: the night version of the birds, faster and in a zigzag
    function colony() {
      const size = Math.ceil(between(1, 3.4));
      const dir = Math.random() < 0.5 ? 'right' : 'left';
      const top = between(10, 32);
      for (let i = 0; i < size; i++) {
        window.setTimeout(() => {
          const one = spawn(
            'tpl-bat',
            {
              '--top': `${top + between(-7, 7)}%`,
              '--dur': `${between(9, 13)}s`,
              '--rise': `${between(-60, 60)}px`,
              '--scale': between(0.7, 1.1).toFixed(2),
            },
            { 'data-dir': dir },
          );
          one?.addEventListener('click', () => {
            speedUp(one, 5);
            say('sayBatClick', 'surprise');
          });
        }, i * between(150, 450));
      }
      if (Math.random() < 0.25) window.setTimeout(() => say('sayBat', 'surprise'), 1800);
    }

    function shootingStar() {
      // Head first, always falling: down-right or down-left
      const tilt = between(15, 35);
      const angle = Math.random() < 0.5 ? tilt : 180 - tilt;
      const rad = (angle * Math.PI) / 180;
      const dist = between(260, 480);
      spawn('tpl-shoot', {
        '--top': `${between(14, 45)}%`,
        '--left': `${between(10, 85)}%`,
        '--angle': `${angle}deg`,
        '--dx': `${Math.cos(rad) * dist}px`,
        '--dy': `${Math.sin(rad) * dist}px`,
      });
      if (Math.random() < 0.2) say('sayWish', 'wink');
    }

    function flyingSaucer() {
      const dir = Math.random() < 0.5 ? 'right' : 'left';
      const saucer = spawn(
        'tpl-ufo',
        { '--top': `${between(9, 12)}%`, '--dur': `${between(18, 26)}s`, '--rise': `${between(-20, 10)}px` },
        { 'data-dir': dir },
      );
      if (!saucer) return;
      window.setTimeout(() => say('sayUfo', 'surprise', 2200), 1800);
      saucer.addEventListener('click', () => {
        saucer.setAttribute('data-caught', '');
        say('sayUfoClick', 'grin', 2200);
        window.setTimeout(() => speedUp(saucer, 8), 500);
      });
    }

    const every = (min: number, max: number, fn: () => void) => {
      const next = () =>
        window.setTimeout(() => {
          if (awake()) fn();
          next();
        }, between(min, max));
      next();
    };
    every(6000, 13000, () => !dark() && flock());
    every(2500, 7000, () => dark() && shootingStar());
    every(8000, 16000, () => dark() && colony());
    every(40000, 75000, () => dark() && flyingSaucer());
    // A first visit at night gets the UFO early
    window.setTimeout(() => awake() && dark() && flyingSaucer(), 9000);
    window.setTimeout(() => awake() && !dark() && flock(), 1500);
  }
</script>

<script>
  import { madridHour, madridTime } from '../avatar/element';

  /* The sun follows the real time in Madrid, and the chip under the hero tells it */
  const sun = document.querySelector<HTMLElement>('.hero .sun');
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  function tick() {
    const hour = madridHour() + new Date().getMinutes() / 60;
    // 7:00 → rising on the left, 14:00 → high in the middle, 21:00 → setting on the right
    const day = Math.min(1, Math.max(0, (hour - 7) / 14));
    sun?.style.setProperty('--sun-x', `${8 + day * 80}%`);
    sun?.style.setProperty('--sun-y', `${34 - Math.sin(day * Math.PI) * 28}%`);
    sun?.style.setProperty('--sun-warm', (Math.abs(day - 0.5) * 2).toFixed(2));
    if (clock) {
      const asleep = hour >= 1 && hour < 7;
      clock.querySelector('[data-time]')!.textContent = madridTime();
      clock.querySelector('[data-state]')!.textContent = (asleep ? clock.dataset.asleep : clock.dataset.awake) ?? '';
      clock.toggleAttribute('data-asleep', asleep);
    }
  }
  tick();
  setInterval(tick, 30_000);

  /* The stack: pick a tool in the orbit (or in the chips on phones) and the card tells about it */
  const stack = document.querySelector<HTMLElement>('.stack');
  const card = document.querySelector<HTMLElement>('[data-tool-card]');
  if (stack && card) {
    const tools = JSON.parse(card.dataset.tools ?? '{}') as Record<string, { name: string; ring: string; say: string }>;
    const orbit = stack.querySelector<HTMLElement>('.orbit');
    let held: string | null = null;

    const show = (id: string) => {
      const tool = tools[id];
      if (!tool) return;
      card.querySelector('[data-name]')!.textContent = tool.name;
      card.querySelector('[data-ring]')!.textContent = tool.ring;
      card.querySelector('[data-say]')!.textContent = tool.say;
      card.querySelectorAll<HTMLElement>('[data-icon]').forEach((icon) => (icon.hidden = icon.dataset.icon !== id));
      stack.querySelectorAll<HTMLElement>('[data-tool]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tool === id)));
    };

    stack.querySelectorAll<HTMLElement>('[data-tool]').forEach((button) => {
      const id = button.dataset.tool!;
      button.addEventListener('pointerenter', () => !held && show(id));
      button.addEventListener('focus', () => show(id));
      // A click (or a tap) keeps the choice and stops the orbit until the next click
      button.addEventListener('click', () => {
        held = held === id ? null : id;
        orbit?.toggleAttribute('data-held', !!held);
        show(id);
      });
    });
    orbit?.addEventListener('pointerleave', () => held && show(held));

    // The orbit only turns while you can see it
    new IntersectionObserver(([entry]) => stack.toggleAttribute('data-visible', entry.isIntersecting)).observe(stack);
  }

  /* The avatar narrates: one line per section, once per visit, from the avatar you can see */
  const told = new Set<string>();
  const narrator = new IntersectionObserver(
    (entries) =>
      entries.forEach((entry) => {
        const section = entry.target as HTMLElement;
        if (!entry.isIntersecting || told.has(section.id)) return;
        told.add(section.id);
        // Wait for the avatar to land if it is flying to the header right now
        window.setTimeout(
          () => document.dispatchEvent(new CustomEvent('avatar:mood', { detail: { expr: 'smile', say: section.dataset.narrate, ms: 2600 } })),
          750,
        );
      }),
    { threshold: 0.35 },
  );
  document.querySelectorAll<HTMLElement>('[data-narrate]').forEach((section) => narrator.observe(section));
</script>

<style>
  /* Hero */
  /* The hero runs under the floating header, so the sky shows through the glass */
  .hero {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding-block: calc(var(--header-h) + clamp(40px, 7vw, 96px)) clamp(56px, 9vw, 120px);
  }
  /* Sky behind the hero: day in the light theme, night in the dark theme */
  .sky,
  .sky > div {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sky > div {
    transition: opacity 0.8s ease;
  }
  .night,
  :global(:root[data-theme='dark']) .day {
    opacity: 0;
  }
  :global(:root[data-theme='dark']) .night {
    opacity: 1;
  }
  /* Day: a soft sky, a warm sun with slow rays, fluffy clouds at three depths */
  .daylight {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 55% at 88% 0%, rgba(255, 226, 160, 0.55), transparent 70%),
      linear-gradient(180deg, #cfe9ef 0%, color-mix(in srgb, #cfe9ef 40%, var(--paper)) 45%, var(--paper) 85%);
  }
  /* The sun: a white-hot core and a warm halo; it moves with the real time in Madrid (see the script) */
  .sun {
    position: absolute;
    left: var(--sun-x, 82%);
    top: calc(var(--header-h) + var(--sun-y, 8%));
    width: clamp(64px, 7vw, 100px);
    aspect-ratio: 1;
    translate: -50% 0;
    /* Warmer at sunrise and sunset */
    filter: sepia(calc(var(--sun-warm, 0) * 0.55)) saturate(calc(1 + var(--sun-warm, 0) * 0.8));
    transition:
      left 2s ease,
      top 2s ease;
  }
  .sun > span {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
  }
  .glow {
    width: 520%;
    aspect-ratio: 1;
    /* One continuous bloom from the core outwards: no rim anywhere */
    background: radial-gradient(
      circle closest-side,
      rgba(255, 255, 248, 0.95) 0%,
      rgba(255, 250, 228, 0.7) 9%,
      rgba(255, 238, 190, 0.42) 20%,
      rgba(255, 226, 165, 0.2) 38%,
      rgba(255, 220, 150, 0.07) 62%,
      transparent 100%
    );
  }
  .disc {
    width: 100%;
    aspect-ratio: 1;
    /* Overexposed: white that melts into warm light, with no visible rim */
    background: radial-gradient(circle closest-side, #ffffff 0 52%, rgba(255, 254, 248, 0.9) 64%, rgba(255, 248, 226, 0.45) 80%, transparent 100%);
  }
  .rays {
    width: 1200px;
    aspect-ratio: 1;
    border-radius: 0;
    background: conic-gradient(
      from 8deg,
      rgba(255, 244, 210, 0.22) 0deg 3deg, transparent 7deg 29deg,
      rgba(255, 244, 210, 0.14) 31deg 36deg, transparent 40deg 71deg,
      rgba(255, 244, 210, 0.2) 73deg 76deg, transparent 80deg 118deg,
      rgba(255, 244, 210, 0.12) 121deg 128deg, transparent 133deg 167deg,
      rgba(255, 244, 210, 0.18) 169deg 172deg, transparent 176deg 209deg,
      rgba(255, 244, 210, 0.13) 212deg 218deg, transparent 223deg 262deg,
      rgba(255, 244, 210, 0.2) 264deg 268deg, transparent 272deg 311deg,
      rgba(255, 244, 210, 0.15) 314deg 320deg, transparent 325deg 360deg
    );
    filter: blur(8px);
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(circle, #000 0 5%, rgba(0, 0, 0, 0.45) 18%, transparent 46%);
    mask-image: radial-gradient(circle, #000 0 5%, rgba(0, 0, 0, 0.45) 18%, transparent 46%);
    animation: spin 240s linear infinite;
  }
  .puff {
    position: absolute;
    left: 0;
    top: var(--top);
    width: var(--w);
    aspect-ratio: 2.4;
    opacity: var(--o);
    filter: blur(1.5px) drop-shadow(0 14px 18px rgba(70, 130, 150, 0.12));
    animation: drift var(--speed) linear var(--start) infinite;
  }
  /* Each puff: bright on top, a little grey-blue at the bottom, soft edges */
  .puff i {
    position: absolute;
    left: var(--bx);
    top: var(--by);
    width: var(--bs);
    aspect-ratio: 1;
    translate: 0 -30%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, #ffffff 0 40%, rgba(244, 250, 252, 0.95) 56%, rgba(214, 233, 240, 0.6) 66%, rgba(214, 233, 240, 0) 72%);
  }
  /* Far clouds are small, pale and slow; near ones are bigger and faster. All of them stay in
     the band above the text, so nothing passes behind the headline */
  .p1 {
    --top: calc(var(--header-h) + 6px);
    --w: 110px;
    --o: 0.55;
    --speed: 190s;
