  }
  @keyframes drift {
    from {
      translate: -260px 0;
    }
    to {
      translate: 100vw 0;
    }
  }

  /* Hills on the horizon: soft cyan by day, dark silhouettes under the stars */
  .hills {
    position: absolute;
