    background: radial-gradient(circle at 38% 34%, #fffdf4 0%, #e9edf2 48%, #c3ccd8 100%);
    /* The phase: a soft shadow on the right side, and a halo of light */
    box-shadow:
      inset -14px -4px 18px -6px rgba(8, 18, 30, 0.75),
