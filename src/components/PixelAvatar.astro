---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** CSS width, e.g. "clamp(220px, 32vw, 380px)" */
  size?: string;
  expr?: 'normal' | 'smile' | 'grin' | 'wink' | 'surprise' | 'tongue' | 'sleep';
  shape?: 'rounded' | 'circle' | 'square';
  bg?: 'brand' | 'none';
  airpods?: boolean;
  follow?: boolean;
  sleepy?: boolean;
  greet?: boolean;
  bubble?: boolean;
  bubbleSide?: 'left' | 'right' | 'top' | 'below';
  /** This avatar is the one that travels between pages (view transitions) */
  vt?: boolean;
  class?: string;
}

const {
  lang,
  size = '240px',
  expr = 'normal',
  shape = 'rounded',
  bg = 'brand',
  airpods = false,
  follow = false,
  sleepy = false,
  greet = false,
  bubble = true,
  bubbleSide = 'left',
  vt = false,
  class: className,
} = Astro.props;
const t = useTranslations(lang);
// Custom elements get "false" as a string, so omit false booleans instead
---

<pixel-avatar
  class:list={['avatar', className]}
  style={`--size: ${size}`}
  expr={expr}
  shape={shape}
  bg={bg}
  airpods={airpods || undefined}
  follow={follow || undefined}
  sleepy={sleepy || undefined}
  greeting={greet ? t('avatar.greeting') : undefined}
  greeting-touch={greet ? t('avatar.greeting.touch') : undefined}
  lines={JSON.stringify(t('avatar.lines'))}
  sleep-say={t('avatar.sleep')}
  wake-say={t('avatar.wake')}
  airpods-say={t('avatar.airpods')}
  day-say={t('avatar.day')}
  night-say={t('avatar.night')}
  data-side={bubbleSide}
  data-vt={vt || undefined}
>
  <img class="fallback" src="/images/antonio-giroz.png" alt="" width="960" height="960" loading="eager" />
  <canvas role="img" aria-label={t('avatar.alt')}></canvas>
  {bubble && <span class="bubble" data-bubble aria-hidden="true"></span>}
</pixel-avatar>

<script>
  import '../avatar/element';
</script>

<style>
  pixel-avatar {
    display: block;
    position: relative;
    width: var(--size);
    max-width: 100%;
    aspect-ratio: 1;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  canvas,
  .fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    filter: drop-shadow(0 18px 30px color-mix(in srgb, var(--shadow) 28%, transparent));
  }

  .fallback {
    border-radius: 23%;
  }
  pixel-avatar[shape='circle'] .fallback {
    border-radius: 50%;
  }
  pixel-avatar[shape='square'] .fallback {
    border-radius: 0;
  }
  pixel-avatar[data-ready] .fallback {
    visibility: hidden;
  }

  .bubble {
    position: absolute;
    bottom: calc(100% - 4%);
    right: 62%;
    z-index: 2;
    width: max-content;
    max-width: min(26ch, 70vw);
    padding: 10px 14px;
    font: 400 13px/1.35 var(--pixel);
    color: var(--ink);
    background: var(--surface);
    border: 3px solid var(--ink);
    box-shadow: 4px 4px 0 var(--brand);
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transform-origin: bottom right;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
    pointer-events: none;
  }
  .bubble::after {
    content: '';
    position: absolute;
    right: 18px;
    bottom: -12px;
    width: 12px;
    height: 12px;
    background: var(--surface);
    border-right: 3px solid var(--ink);
    border-bottom: 3px solid var(--ink);
    transform: skewX(40deg);
  }
  pixel-avatar[data-side='right'] .bubble {
    right: auto;
    left: 62%;
    transform-origin: bottom left;
  }
  pixel-avatar[data-side='right'] .bubble::after {
    right: auto;
    left: 18px;
    border-right: 0;
    border-left: 3px solid var(--ink);
    transform: skewX(-40deg);
  }
  .bubble[data-show] {
    opacity: 1;
    transform: none;
  }

  /* Centered above the avatar: for small screens, and when text is next to it */
  pixel-avatar[data-side='top'] .bubble {
    left: 50%;
    right: auto;
    bottom: calc(100% + 6px);
    translate: -50% 0;
    transform-origin: bottom center;
    max-width: max(100%, 180px);
  }
  pixel-avatar[data-side='top'] .bubble::after {
    left: calc(50% - 6px);
    right: auto;
  }
  /* Hanging under the avatar (in the header), tail pointing up */
  pixel-avatar[data-side='below'] .bubble {
    top: calc(100% + 14px);
    bottom: auto;
    left: 0;
    right: auto;
    translate: none;
    transform-origin: top left;
  }
  pixel-avatar[data-side='below'] .bubble::after {
    top: -12px;
    bottom: auto;
    left: 12px;
    right: auto;
    border: 0;
    border-left: 3px solid var(--ink);
    border-top: 3px solid var(--ink);
    transform: skewX(40deg);
  }
  pixel-avatar[data-vt] {
    view-transition-name: avatar;
  }
  @media (max-width: 640px) {
    pixel-avatar:not([data-side='below']) .bubble,
    pixel-avatar[data-side='right'] .bubble {
      left: 50%;
      right: auto;
      translate: -50% 0;
      transform-origin: bottom center;
    }
    pixel-avatar:not([data-side='below']) .bubble::after,
    pixel-avatar[data-side='right'] .bubble::after {
      left: calc(50% - 6px);
      right: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      transition: none;
    }
  }
</style>
